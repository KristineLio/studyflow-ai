# Leave unset to use honest demo mode + self-assessment for subjective answers.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# SQLite local to backend process. Not suitable for multi-user production hosting.
STUDYFLOW_DB=./studyflow.sqlite3
# Comma-separated allowed origins for React dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Never enable on an unauthenticated public server.
ALLOW_DEV_EXPORT=0